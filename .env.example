# Telegram Web Login (BotFather → Bot Settings → Web Login)
TELEGRAM_CLIENT_ID=123456789
TELEGRAM_CLIENT_SECRET=replace_with_client_secret_from_botfather

# Strongly recommended on Vercel. It must exactly match one of the Allowed URLs
# configured in BotFather. Replace with your stable production domain.
TELEGRAM_REDIRECT_URI=https://your-project.vercel.app/api/auth/telegram/callback

# Used to sign the HTTP-only login cookie. Use 24+ random characters.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_24_characters

# PostgreSQL connection string from Neon, Supabase, Railway, or another provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# REQUIRED for Telegram admin commands. Copy the HTTP API token from BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_real_bot_token

# REQUIRED for /admin. Comma-separated Telegram IDs allowed to view user data.
# After the bot connects, send /id to get your number.
TELEGRAM_ADMIN_IDS=123456789

# Optional. If omitted, the app safely generates a stable webhook secret from
# SESSION_SECRET. Use only letters, numbers, underscores, or hyphens.
TELEGRAM_WEBHOOK_SECRET=

# Optional manual setup password. Automatic setup does not need this value.
TELEGRAM_SETUP_KEY=

# Optional stable public app URL. Vercel's production project URL is detected
# automatically when this is omitted.
TELEGRAM_PUBLIC_URL=https://your-project.vercel.app

ADMIN_TIMEZONE=Asia/Phnom_Penh

# Optional. Send a Telegram message to every TELEGRAM_ADMIN_IDS account after
# each successful Telegram web login. Enabled by default; set false to disable.
TELEGRAM_LOGIN_ALERTS_ENABLED=true

# TikTok Login Kit + Content Posting API (Sandbox first)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://theziessmethod.site/api/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.upload
# Generate a 32-byte key, for example: openssl rand -base64 32
TIKTOK_TOKEN_ENCRYPTION_KEY=
TIKTOK_PUBLIC_URL=https://theziessmethod.site

# Telegram group welcome system. Uses the existing bot webhook.
TELEGRAM_WELCOME_ENABLED=true
# Supported values: km, en, both
TELEGRAM_WELCOME_LANGUAGE=both
# Supported placeholders: {mention}, {name}, {group}
TELEGRAM_WELCOME_KHMER_TEMPLATE=សូមស្វាគមន៍ {mention} មកកាន់ក្រុម <b>{group}</b> 🎉
TELEGRAM_WELCOME_ENGLISH_TEMPLATE=Welcome {mention} to <b>{group}</b> 🎉
# Optional inline buttons. Leave either URL empty to hide that button.
TELEGRAM_WELCOME_RULES_URL=
TELEGRAM_WELCOME_WEBSITE_URL=https://theziessmethod.site
TELEGRAM_WELCOME_RULES_LABEL=📜 Rules
TELEGRAM_WELCOME_WEBSITE_LABEL=🌐 Website

# Hosted real-video FPS checker (PEACHY port 3008)
TIKTOK_CHECKER_API_URL=http://panel.peachygang.app:3008
# Must match FPS_API_KEY on the bot hosting server.
TIKTOK_CHECKER_API_KEY=CHANGE_ME_TO_THE_SAME_LONG_RANDOM_SECRET
TIKTOK_CHECKER_PROXY_TIMEOUT_MS=8000
